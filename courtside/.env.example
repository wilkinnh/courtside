# Loopback by default. Use 0.0.0.0 to allow your LAN / Home Assistant to connect.
BIND_ADDRESS=127.0.0.1
PORT=8788
# Optional: at least 24 characters. Leave empty on a trusted home network.
# When set, enter it in the website's Preferences for this browser session,
# and send Authorization: Bearer <key> from Home Assistant.
COURTSIDE_API_KEY=

# Server-only credentials; never use a VITE_ prefix for these values.
HOME_ASSISTANT_URL=http://192.168.1.100:8123
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_SCRIPT=script.courtside_play

# Node preference storage (Docker uses its persistent /app/data volume).
COURTSIDE_DATA_DIR=data
