# Loopback by default. Use 0.0.0.0 to allow your LAN / Home Assistant to connect.
BIND_ADDRESS=127.0.0.1
PORT=8788
# Optional: at least 24 characters. Leave empty on a trusted home network.
# When set, enter it in the website's Preferences for this browser session,
# and send Authorization: Bearer <key> from Home Assistant.
COURTSIDE_API_KEY=
